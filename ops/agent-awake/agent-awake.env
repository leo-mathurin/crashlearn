# Seconds between activity checks and before an idle poweroff.
INTERVAL=15
IDLE_TIMEOUT=3600

# Signals inherited from the former dev-tower VM activity detector.
CHARGE_SEUIL=0.5
SAISIE_S=900
AGENT_LEASE_DIR=/run/user/1000/agent-awake/leases
AGENT_LEASE_TTL=600
T3_STATE_DB=/home/leo/.t3/userdata/state.sqlite
BUN=/home/leo/.bun/bin/bun
