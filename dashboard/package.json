{
  "name": "crashlearn-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun server.ts",
    "dev": "bun --hot server.ts --dev",
    "build": "bun build ./index.html --outdir dist --minify",
    "lint": "oxlint --deny-warnings .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:e2e": "playwright test",
    "measure": "bun scripts/measure-performance.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/bun": "^1.4.4",
    "@types/three": "^0.187.0",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.4"
}
